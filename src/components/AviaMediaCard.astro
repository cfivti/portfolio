---
interface Props { id: string; label: string; images: string[]; animation: string; tone?: string; }
const { id, label, images, animation, tone = 'gray' } = Astro.props;
const slides = images.length > 1 ? [images[images.length - 1], ...images, images[0]] : images;
---
<figure class="media-gallery" id={id} data-images={JSON.stringify(images)} data-animation={animation} aria-label={label}>
  <div class:list={['media-stage', tone]} tabindex="0" role="group" aria-roledescription="карусель" aria-label={label}>
    <div class="carousel-track" style={`transform: translateX(-${images.length > 1 ? 100 : 0}%)`}>
      {slides.map((src, position) => (
        <div class="carousel-slide" aria-hidden={position !== (images.length > 1 ? 1 : 0)}>
          <img src={src} alt={label} loading="lazy" decoding="async" width="370" height="520" draggable="false" />
        </div>
      ))}
    </div>
    <img class="gif-image" alt={`${label}, GIF-анимация`} width="370" height="520" hidden />
  </div>
  <div class="media-controls">
    <button type="button" class="mode-button" aria-label="Смотреть GIF" title="Смотреть GIF" aria-pressed="false">GIF</button>
    <div class="arrows">
      <button type="button" class="prev-button" aria-label="Предыдущее изображение" title="Предыдущее изображение"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg></button>
      <button type="button" class="next-button" aria-label="Следующее изображение" title="Следующее изображение"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
    </div>
  </div>
  <span class="sr-status" aria-live="polite" aria-atomic="true"></span>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.media-gallery').forEach(gallery => {
    const images: string[] = JSON.parse(gallery.dataset.images || '[]');
    const stage = gallery.querySelector<HTMLElement>('.media-stage')!;
    const track = gallery.querySelector<HTMLElement>('.carousel-track')!;
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.carousel-slide'));
    const gif = gallery.querySelector<HTMLImageElement>('.gif-image')!;
    const mode = gallery.querySelector<HTMLButtonElement>('.mode-button')!;
    const prev = gallery.querySelector<HTMLButtonElement>('.prev-button')!;
    const next = gallery.querySelector<HTMLButtonElement>('.next-button')!;
    const status = gallery.querySelector<HTMLElement>('.sr-status')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let position = images.length > 1 ? 1 : 0;
    let animated = false;
    let moving = false;
    let finishTimer: ReturnType<typeof setTimeout>;
    const place = (animate: boolean) => {
      track.style.transition = animate ? 'transform 400ms cubic-bezier(.22,.68,0,1)' : 'none';
      track.style.transform = `translateX(-${position * 100}%)`;
      slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(animated || i !== position)));
    };
    const finish = () => {
      clearTimeout(finishTimer);
      position = images.length > 1 ? index + 1 : 0;
      place(false);
      moving = false;
    };
    const move = (direction: number) => {
      if (animated || moving || images.length < 2) return;
      moving = true;
      position += direction;
      index = (index + direction + images.length) % images.length;
      place(!reducedMotion.matches);
      status.textContent = `Изображение ${index + 1} из ${images.length}`;
      if (reducedMotion.matches) finish();
      else finishTimer = setTimeout(finish, 450);
    };
    track.addEventListener('transitionend', e => { if (e.target === track && e.propertyName === 'transform') finish(); });
    mode.addEventListener('click', () => {
      finish();
      animated = !animated;
      gif.hidden = !animated;
      track.hidden = animated;
      if (animated) gif.src = gallery.dataset.animation!;
      else gif.removeAttribute('src');
      mode.setAttribute('aria-pressed', String(animated));
      mode.setAttribute('aria-label', animated ? 'Смотреть изображения' : 'Смотреть GIF');
      mode.title = mode.getAttribute('aria-label')!;
      prev.disabled = next.disabled = animated || images.length < 2;
      status.textContent = animated ? 'GIF-анимация' : `Изображение ${index + 1} из ${images.length}`;
      place(false);
    });
    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    stage.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); move(e.key === 'ArrowLeft' ? -1 : 1); }
    });
    let startX = 0;
    let startY = 0;
    stage.addEventListener('touchstart', e => { startX = e.changedTouches[0].clientX; startY = e.changedTouches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) move(dx < 0 ? 1 : -1);
    }, { passive: true });
    prev.disabled = next.disabled = images.length < 2;
    place(false);
  });
</script>

<style>
  .media-gallery { width: 100%; margin: 0; }
  .media-stage { position: relative; width: 100%; height: 520px; border-radius: 24px; overflow: hidden; background: #eee; touch-action: pan-y; }
  @supports (corner-shape: superellipse(1.6)) { .media-stage { corner-shape: superellipse(1.6); } }
  .media-stage.lavender { background: #eae8f0; }
  .media-stage.dark { background: #808080; }
  .carousel-track { display: flex; width: 100%; height: 100%; }
  .carousel-track[hidden], .gif-image[hidden] { display: none; }
  .carousel-slide { flex: 0 0 100%; width: 100%; min-width: 0; height: 100%; }
  .media-stage img { width: 100%; height: 100%; object-fit: contain; user-select: none; }
  .gif-image { position: absolute; inset: 0; }
  .media-controls { display: flex; align-items: center; padding-top: 12px; }
  button { width: 40px; height: 40px; display: grid; place-items: center; border: 0; border-radius: 50%; background: #f0f0f0; color: #393934; cursor: pointer; padding: 0; transition: background .18s, opacity .18s; }
  button svg { width: 21px; height: 21px; }
  button:hover:not(:disabled) { background: #e2e2e2; }
  button:focus-visible, .media-stage:focus-visible { outline: 2px solid #555; outline-offset: 4px; }
  button:disabled { opacity: .3; cursor: default; }
  .mode-button { font: 500 11px/1 'Onest', sans-serif; letter-spacing: -.02em; }
  .mode-button[aria-pressed='true'] { background: #393934; color: #fff; }
  .arrows { margin-left: auto; display: flex; gap: 12px; }
  .sr-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>
