<span class="workflow-cover" aria-hidden="true">
  <span class="workflow-cover__grid">
    {Array.from({ length: 192 }, (_, i) => (
      <span class="workflow-cover__cell" style={`--delay: -${(i * 1.73) % 9}s; --duration: ${3 + (i * 7 % 23) / 10}s; --tone: ${170 + i * 13 % 45}`} />
    ))}
  </span>
  <span class="workflow-cover__title">Workflow CRM<span>На доработке</span></span>
</span>

<style>
  .workflow-cover { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 1040 / 620; overflow: hidden; border-radius: 8px; background: #e7e7e7; color: #555; }
  .workflow-cover__grid { position: absolute; inset: 0; padding: 16px; display: grid; grid-template-columns: repeat(16, 1fr); grid-template-rows: repeat(12, 1fr); gap: 8px; mask-image: linear-gradient(transparent, #000 85%); }
  .workflow-cover__cell { align-self: center; justify-self: center; width: 65%; aspect-ratio: 1; max-height: 100%; background: rgb(var(--tone), var(--tone), var(--tone)); animation: cell-pulse var(--duration) var(--delay) ease-in-out infinite alternate; animation-play-state: paused; }
  .workflow-cover.is-visible .workflow-cover__cell { animation-play-state: running; }
  .workflow-cover__title { position: relative; display: flex; flex-direction: column; gap: 10px; font: 500 clamp(22px, 4vw, 42px)/1.2 'Onest', sans-serif; letter-spacing: -.04em; }
  .workflow-cover__title > span { font-size: 13px; font-weight: 400; letter-spacing: 0; color: #777; }
  @keyframes cell-pulse {
    0%, 15% { transform: scale(.15); border-radius: 50%; opacity: .35; }
    70% { transform: scale(.95); border-radius: 2px; opacity: .8; }
    100% { transform: scale(.55) rotate(45deg); border-radius: 25%; opacity: .5; }
  }
  @media (prefers-reduced-motion: reduce) { .workflow-cover__cell { animation: none; opacity: .35; transform: scale(.4); } }
</style>

<script>
  const covers = document.querySelectorAll<HTMLElement>('.workflow-cover');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => entry.target.classList.toggle('is-visible', entry.isIntersecting && !document.hidden));
  });
  covers.forEach(cover => observer.observe(cover));
  document.addEventListener('visibilitychange', () => {
    covers.forEach(cover => {
      const rect = cover.getBoundingClientRect();
      cover.classList.toggle('is-visible', !document.hidden && rect.bottom > 0 && rect.top < innerHeight);
    });
  });
</script>
