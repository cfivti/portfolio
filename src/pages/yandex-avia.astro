---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseTextPage from '../components/CaseTextPage.astro';
import AviaCasePlayer from '../components/AviaCasePlayer.astro';
import { withBase } from '../lib/paths';

const media = (name: string) => withBase(`/yandex-avia/${name}`);

const context = [
  'В текущем экране время, аэропорты и пересадки расположены без чёткого порядка: глаз не находит, за что зацепиться.',
  'Пользователь не успевает разобраться и уходит к конкурентам, где всё понятно и привычно. Люди сканируют их взглядом. Значит, экран должен быть устроен так, чтобы по нему было удобно скользить.',
];
const process = [
  'Собрал всех конкурентов, разобрал каждый элемент интерфейса и сценарий пользователя',
  'Пересобрал экран деталей, снизил время считывания информации и дал затестить знакомым',
  'Пересобрал экран деталей, снизил время считывания информации и дал затестить знакомым',
];
const solution = [
  'В текущем экране время, аэропорты и пересадки расположены без чёткого порядка: глаз не находит, за что зацепиться.',
  'Пользователь не успевает разобраться и уходит к конкурентам, где всё понятно и привычно. Люди сканируют их взглядом. Значит, экран должен быть устроен так, чтобы по нему было удобно скользить.',
];
const catalogFrames = [
  { src: media('search-catalog-before.webp'), alt: 'Детали билета до редизайна' },
  { src: media('search-catalog-after.webp'), alt: 'Детали билета после редизайна' },
];
const flightFrames = [
  { src: media('flight-information-overview.webp'), alt: 'Открытый попап с фотографией самолёта' },
  { src: media('flight-information-stats.webp'), alt: 'Обзор и статистика задержек в попапе' },
];
---

<BaseLayout title="Редизайн экрана деталей авиа-билета — Иван Колесников">
  <CaseTextPage title="Редизайн экрана деталей авиа-билета" context={context} process={process} solution={solution} mediaAfterProcess mediaAfterSolution>
    <AviaCasePlayer slot="hero" video={media('case-overview.mp4?v=31f67ebc42')} poster={media('case-overview-poster.webp')} label="Обзор сценария от поиска билета до выбора тарифа" phone />
    <AviaCasePlayer slot="after-process" video={media('search-catalog.mp4')} poster={media('search-catalog-poster.webp')} label="Трансформация каталога и деталей авиабилета" frames={catalogFrames} />
    <AviaCasePlayer slot="after-solution" video={media('flight-information.mp4')} poster={media('flight-information-poster.webp')} label="Попап с информацией о рейсе" frames={flightFrames} />
  </CaseTextPage>
</BaseLayout>
