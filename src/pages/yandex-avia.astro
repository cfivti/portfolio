---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaCard from '../components/AviaMediaCard.astro';
import { withBase } from '../lib/paths';
const asset = (name: string) => withBase(`/yandex-avia/${name}`);
---

<BaseLayout title="Ускорил покупку билета на Яндекс Авиа — Иван Колесников">
  <main class="avia-case">
    <a class="back" href={withBase('/')} aria-label="Вернуться к проектам"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg>Все проекты</a>
    <header class="case-intro">
      <time datetime="2026-11-01">1-11-2026</time>
      <h1>Ускорил покупку билета<br />на Яндекс Авиа</h1>
      <span class="figma-tag">Figma</span>
    </header>

    <section aria-labelledby="context">
      <h2 id="context">Контекст и проблема</h2>
      <div class="copy">
        <p>Люди, выбирая билет, как правило, считывают информацию, сканируя экран отрезками. Этот паттерн не ложится на текущий UI.</p>
        <p>Сейчас экраны, участвующие в покупке билета, выглядят загруженными. Чтобы понять — нужно вчитываться.</p>
        <p>Вчитывание увеличивает время взаимодействия, но не делает опыт пользователя положительным.</p>
      </div>
      <MediaCard id="overview" label="Маршрут и детали рейса" images={[asset('route.webp'), asset('details.webp')]} animation={asset('flight.gif')} tone="lavender" />
    </section>

    <section class="solution" aria-labelledby="solution">
      <h1 id="solution">Решение</h1>
      <section aria-labelledby="ticket">
        <h2 id="ticket">Билет</h2>
        <MediaCard id="ticket-gallery" label="Карточка авиабилета" images={[asset('ticket-1.svg'), asset('ticket-2.svg'), asset('ticket-3.svg')]} animation={asset('ticket.gif')} tone="gray" />
        <div class="explanation">
          <p>При исследовании я собрал гипотезу с определением приоритетов информации</p>
          <ol><li>Цена</li><li>Маршрут</li><li>Бейджи багажа, клади</li><li>Авиакомпании</li><li>Бейджи товара</li></ol>
          <p>Скруглил углы, бейджи вынес на грань билета, цену вынес в приоритет. Информацию стало проще считывать по блокам.</p>
        </div>
      </section>

      <section class="detail-section" aria-labelledby="information">
        <h2 id="information">Информация о билете</h2>
        <MediaCard id="details-gallery" label="Информация о билете и обзор рейса" images={[asset('details.webp'), asset('route.webp')]} animation={asset('flight.gif')} tone="lavender" />
        <div class="explanation">
          <p>Маршрут выстроил в последовательность: вылет, пересадка, прилёт. Длительность пересадки выделил внутри маршрута.</p>
          <p>Подробности о рейсе открываются отдельно. Основной экран помогает просмотреть путь, а детали — разобраться в условиях и выбрать билет.</p>
        </div>
      </section>

      <section class="detail-section" aria-labelledby="filters">
        <h2 id="filters">Фильтры поиска</h2>
        <MediaCard id="filters-gallery" label="Фильтры поиска авиабилетов" images={[asset('filters-1.svg'), asset('filters-2.svg')]} animation={asset('filters.gif')} tone="dark" />
        <div class="explanation">
          <p>Сгруппировал настройки по задачам: багаж, пересадки и время. Для перелёта туда и обратно можно настроить время отдельно.</p>
          <p>Кнопки применения и отмены закрепил внизу, чтобы результат настройки был доступен на любом участке экрана.</p>
        </div>
      </section>
    </section>
    <footer><span>Самостоятельный концепт · 2026</span><a href={withBase('/')}>Все проекты ↗</a></footer>
  </main>
</BaseLayout>

<style>
  .avia-case { width: min(370px, calc(100% - 32px)); margin: 0 auto; padding: 36px 0 40px; font: 500 16px/1.22 'Onest', Arial, sans-serif; color: #000; }
  .back { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 48px; color: #888; font-size: 13px; text-decoration: none; }
  .back svg { width: 18px; height: 18px; }
  .back:hover { color: #000; }
  time { display: block; color: rgb(0 0 0 / .3); margin-bottom: 12px; }
  h1 { font-size: 24px; font-weight: 400; line-height: 1.2; letter-spacing: -.035em; }
  .figma-tag { display: inline-block; border-radius: 20px; background: #f5f5f5; font-size: 12px; padding: 5px 11px; margin-top: 12px; }
  .case-intro { margin-bottom: 16px; }
  h2 { font-size: 18px; font-weight: 500; line-height: 1.3; color: rgb(0 0 0 / .3); margin: 0 4px 10px; letter-spacing: -.02em; }
  .copy, .explanation { padding-inline: 4px; }
  .copy p + p, .explanation p + p { margin-top: 14px; }
  .copy { margin-bottom: 40px; }
  .solution { margin-top: 64px; }
  .solution > h1 { margin: 0 0 14px; }
  .explanation { margin-top: 30px; }
  ol { padding-left: 24px; margin-block: 12px 20px; color: rgb(0 0 0 / .45); }
  li { padding-left: 0; margin-top: 12px; }
  .detail-section { margin-top: 64px; }
  footer { border-top: 1px solid #eee; margin-top: 64px; padding-top: 24px; display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; color: #999; font-size: 11px; }
  footer a { text-decoration: none; color: #555; }
  a:focus-visible { outline: 2px solid #555; outline-offset: 5px; border-radius: 3px; }
  @media (max-width: 440px) { .avia-case { padding-top: 20px; } .back { margin-bottom: 40px; } }
</style>
