---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseTextPage from '../components/CaseTextPage.astro';

const context = [
  'В текущем экране время, аэропорты и пересадки расположены без чёткого порядка: глаз не находит, за что зацепиться.',
  'Пользователь не успевает разобраться и уходит к конкурентам, где всё понятно и привычно. Люди сканируют их взглядом. Значит, экран должен быть устроен так, чтобы по нему было удобно скользить.',
];
const process = [
  'Собрал всех конкурентов, разобрал каждый элемент интерфейса и сценарий пользователя',
  'Пересобрал экран деталей, снизил время считывания информации и дал затестить знакомым',
  'Пересобрал экран деталей, снизил время считывания информации и дал затестить знакомым',
];
const solution = [
  'В текущем экране время, аэропорты и пересадки расположены без чёткого порядка: глаз не находит, за что зацепиться.',
  'Пользователь не успевает разобраться и уходит к конкурентам, где всё понятно и привычно. Люди сканируют их взглядом. Значит, экран должен быть устроен так, чтобы по нему было удобно скользить.',
];
---

<BaseLayout title="Редизайн экрана деталей авиа-билета — Иван Колесников">
  <CaseTextPage title="Редизайн экрана деталей авиа-билета" context={context} process={process} solution={solution} />
</BaseLayout>
