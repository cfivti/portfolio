---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseTextPage from '../components/CaseTextPage.astro';

const context = [
  'В Лавке есть множество товаров, но некоторые пользователи могут столкнуться с проблемой поиска товара, просто не понимая есть ли этот товар вообще в Лавке',
  'Пользователь ищет через поиск и ничего не находит ни в Лавке у дома, ни в большой. Человек остается в недоумении и разочаровании от несовершенной цели',
];
const process = [
  'Собрал всех конкурентов, разобрал каждый элемент интерфейса и сценарий пользователя',
  'Пересобрал экран деталей, снизил время считывания информации и дал затестить знакомым',
  'Пересобрал экран деталей, снизил время считывания информации и дал затестить знакомым',
];
const solution = [
  'Собрал экран экран “витрины бренда” на котором представлена вся продукция, представленная в лавке. При поиске пользователь будет знать, что товар не представлен в ассортименте.',
  'По мимо этого, витрина помогает улучшить опыт соприкосновения бренда и покупателя (рецепты, акции)',
];
---

<BaseLayout title="Витрина бренда в Яндекс Лавке — Иван Колесников">
  <CaseTextPage title="Витрина бренда в Яндекс Лавке" context={context} process={process} solution={solution} mediaAfterProcess />
</BaseLayout>
