---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import DotBackground from '../components/DotBackground.astro';
import ComingSoonModal from '../components/ComingSoonModal.astro';
import WorkflowCover from '../components/WorkflowCover.astro';
import { cases } from '../lib/portfolio-cases';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Vanya Kolesnikov — продуктовый дизайнер">
  <main class="portfolio-preview">
  <div class="background-layer" aria-hidden="true">
    <div class="intro__depth">
      <DotBackground />
    </div>
  </div>
  <section class="intro" aria-label="Вступление">
    <div class="preview">
    <PortfolioHeader />
    <div class="caption">
      <h1>Джуниор<br />продуктовый дизайнер</h1>
      <p>Помогаю превращать сложные задачи в понятный опыт.</p>
    </div>
    </div>
  </section>
  <section class="projects-plate" aria-labelledby="projects-heading">
    <div class="projects-layout">
      <aside class="about">
        <header><h2>Обо мне</h2><p class="about-role">Junior UX/UI дизайнер</p></header>
        <div class="about-copy">
          <p>Начинающий дизайнер, создаю практичность и эстетику в интерфейсах, хочу вносить свой вклад в развитие продуктов, делающие жизнь людей проще. Вдохновляют сервисы для людей.</p>
          <p>Москва, Россия.</p>
        </div>
        <div class="contacts" aria-label="Скопировать контакт">
          <button class="contact-link" type="button" data-copy="@kolesnikov_product" aria-label="Скопировать Telegram @kolesnikov_product">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.4 3.6 18.2 20c-.2 1-1 1.2-1.8.7l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.3L5.8 13.5 1 12c-1-.3-1-1 .2-1.5L20 3.2c.9-.3 1.6.2 1.4.4Z"/></svg>
            <span>@kolesnikov_product</span>
          </button>
          <button class="contact-link" type="button" data-copy="kolesnikov.product@gmail.com" aria-label="Скопировать почту kolesnikov.product@gmail.com">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
            <span>kolesnikov.product@gmail.com</span>
          </button>
          <button class="contact-link" type="button" data-copy="Vanya_UXUI" aria-label="Скопировать LinkedIn Vanya_UXUI">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM2.3 9h3.4v12H2.3Zm6 0h3.3v1.6c.8-1.2 1.9-1.9 3.5-1.9 3.5 0 4.6 2.2 4.6 5.6V21h-3.4v-6c0-1.7-.3-3.1-2.2-3.1-2 0-2.4 1.5-2.4 3.1v6H8.3Z"/></svg>
            <span>Vanya_UXUI</span>
          </button>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </aside>
      <div class="projects-column">
      <header class="projects-header">
        <h2 id="projects-heading" class="projects-heading">Мои проекты</h2>
        <p>Тут собраны мои концепты и кейс с практики.</p>
      </header>
      <div class="projects-list">
        {cases.map(project => (
          <article class:list={["project", { "project--pending": project.comingSoon }]}>
            {project.comingSoon ? (
              <button class="project-cover" type="button" data-coming-soon aria-label={`${project.title} — скоро`}>
                <WorkflowCover />
              </button>
            ) : (
              <a class="project-cover" href={withBase(project.href)} aria-label={project.title}>
                <img src={project.cover.desktop} alt={project.cover.alt ?? project.title} loading="lazy" width="1040" height="620" />
              </a>
            )}
            <div class="project-caption">
              <div><h3>{project.title}</h3><p>{project.type}</p></div>
              {project.comingSoon ? <button class="project-open" type="button" data-coming-soon>На доработке</button> : <a class="project-open" href={withBase(project.href)}>Открыть ↗</a>}
            </div>
          </article>
        ))}
      </div>
      </div>
    </div>
  </section>
  </main>
  <ComingSoonModal />
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>('.copy-status');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    let feedbackTimer: ReturnType<typeof setTimeout>;
    let copying = false;
    button.addEventListener('click', async () => {
      const value = button.dataset.copy;
      if (!value || copying) return;
      copying = true;
      clearTimeout(feedbackTimer);
      try {
        await navigator.clipboard.writeText(value);
        button.dataset.feedback = 'Скопировано';
        if (status) status.textContent = `Скопировано: ${value}`;
      } catch {
        button.dataset.feedback = 'Не удалось';
        if (status) status.textContent = `Не удалось скопировать. Контакт: ${value}`;
      } finally {
        copying = false;
      }
      feedbackTimer = setTimeout(() => { delete button.dataset.feedback; }, 2000);
    });
  });
</script>

<style>
  .portfolio-preview { background: #080808; isolation: isolate; }
  .background-layer { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; background: #080808; }

  .intro__depth { position: absolute; inset: 0; }
  .intro { position: sticky; top: 0; z-index: 1; min-height: 100svh; }
  .projects-plate { position: relative; z-index: 2; min-height: 100svh; margin-top: -40px; padding-block: 96px 140px; border-radius: 48px 48px 0 0; background: #fff; box-shadow: 0 -20px 70px rgb(0 0 0 / 0.18); }
  .about { position: sticky; top: 32px; align-self: start; }
  .projects-layout { width: min(1360px, calc(100% - 96px)); margin-inline: auto; display: grid; grid-template-columns: minmax(240px, 320px) minmax(0, 1fr); gap: 48px; color: #171717; }
  .about h2, .projects-heading { font-size: 26px; line-height: 1.25; font-weight: 500; letter-spacing: -0.035em; }
  .about p, .projects-header p { color: #333; font-size: 15px; line-height: 1.6; }
  .about-role { margin-top: 4px; }
  .about-copy { margin-block: 44px 28px; }
  .about-copy p + p { margin-top: 18px; }
  .about-details { font-size: 13px; }
  .about-details > div { display: flex; justify-content: space-between; gap: 12px; padding-block: 14px; border-top: 1px solid #eee; }
  .about-details > div:last-child { border-bottom: 1px solid #eee; }
  .about-details dt { color: #777; }
  .about-details a { text-decoration: none; }
  .contact-link, .project-open { display: inline-flex; justify-content: center; align-items: center; padding: 9px 14px; border: 1px solid #e5e5e5; border-radius: 7px; background: #fff; font: inherit; font-size: 13px; text-decoration: none; color: #171717; cursor: pointer; }
  .contacts { display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px solid #e5e5e5; padding-top: 24px; }
  .contact-link { position: relative; gap: 8px; }
  .contact-link[data-feedback] > * { visibility: hidden; }
  .contact-link[data-feedback]::after { content: attr(data-feedback); position: absolute; inset: 0; display: grid; place-items: center; font-size: 12px; }
  .contact-link svg { width: 18px; height: 18px; flex-shrink: 0; }
  .contact-link:disabled { opacity: .45; cursor: default; }
  .contact-link:focus-visible { outline: 2px solid #171717; outline-offset: 3px; }
  .about .copy-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .contact-link:hover, .project-open:hover { background: #f5f5f5; }
  .projects-header { margin-bottom: 28px; }
  .projects-header p { margin-top: 4px; }
  .project { --cover-underlay: #e5e7e9; }
  .project:nth-child(3n + 2) { --cover-underlay: #dce7f5; }
  .project:nth-child(3n + 3) { --cover-underlay: #f5dfd1; }
  .project-cover { position: relative; isolation: isolate; display: block; width: 100%; padding: 0; border: 0; border-radius: 8px; background: transparent; cursor: pointer; }
  .project-cover::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--cover-underlay); transition: transform 280ms ease; }
  .project-cover img { width: 100%; height: auto; aspect-ratio: 1040 / 620; object-fit: cover; border-radius: 8px; transform-origin: 50% 65%; transition: transform 280ms ease, box-shadow 280ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .project:not(.project--pending):hover .project-cover img { transform: translateY(-10px) rotate(1.2deg); box-shadow: 0 14px 24px rgb(0 0 0 / 0.12); }
    .project:not(.project--pending):hover .project-cover::before { transform: translate(-5px, 5px) rotate(-0.6deg); }
  }
  .project:not(.project--pending):focus-within .project-cover img { transform: translateY(-10px) rotate(1.2deg); box-shadow: 0 14px 24px rgb(0 0 0 / 0.12); }
  .project:not(.project--pending):focus-within .project-cover::before { transform: translate(-5px, 5px) rotate(-0.6deg); }
  .project-cover:focus-visible { outline: 2px solid #171717; outline-offset: 6px; }
  @media (prefers-reduced-motion: reduce) {
    .project-cover img { transition: none; }
    .project:not(.project--pending):hover .project-cover img, .project:not(.project--pending):focus-within .project-cover img { transform: none; box-shadow: none; }
    .project-cover::before { transition: none; }
    .project:not(.project--pending):hover .project-cover::before, .project:not(.project--pending):focus-within .project-cover::before { transform: none; }
  }
  .project-caption { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding-block: 18px 24px; border-bottom: 1px solid #eee; }
  .project-caption h3 { font-size: 16px; font-weight: 500; line-height: 1.5; }
  .project-caption p { margin-top: 4px; color: #777; font-size: 14px; }
  .project-open { flex-shrink: 0; }
  @media (max-width: 900px) { .projects-layout { width: calc(100% - 48px); grid-template-columns: 1fr; gap: 48px; } .about { max-width: 540px; } .about-copy { margin-top: 24px; } }
  @media (max-width: 480px) { .projects-layout { width: calc(100% - 40px); } .project-caption { gap: 12px; } .project-caption h3 { font-size: 15px; } }
  @media (max-width: 900px) { .about { position: static; max-height: none; overflow: visible; } }
  @media (max-width: 900px) { .projects-column { border-top: 1px solid #e5e5e5; padding-top: 32px; } }
  .projects-list { display: flex; flex-direction: column; gap: 32px; }
  .preview { position: relative; width: min(1360px, calc(100% - 96px)); margin-inline: auto; min-height: 100svh; color: #f3f1e8; padding-block: 36px 64px; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; }
  .intro-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; pointer-events: auto; }
  .intro-author { font-size: 20px; font-weight: 500; text-decoration: none; letter-spacing: -.03em; }
  .intro-resume { display: inline-flex; gap: 20px; align-items: center; padding: 11px 20px; border: 1px solid #777; border-radius: 100px; text-decoration: none; font-size: 14px; }
  .intro-resume:hover { background: #f3f1e8; color: #080808; }
  .intro-header a:focus-visible { outline: 2px solid #f3f1e8; outline-offset: 5px; }
  .back { align-self: flex-start; color: #aaa99f; font-size: 14px; text-decoration: none; pointer-events: auto; }
  .back:hover { color: #ffd718; }
  .back:focus-visible { outline: 2px solid #ffd718; outline-offset: 8px; }
  .caption { margin-block: 100px; }
  .label, .signature { font: 11px/1.5 monospace; letter-spacing: 0.16em; color: #929185; }
  h1 { margin: 24px 0; font-size: clamp(44px, 7vw, 100px); font-weight: 400; line-height: 1.04; letter-spacing: -0.055em; }
  p { color: #aaa99f; font-size: 15px; }
  .signature { align-self: flex-end; }
  @media (max-width: 900px) { .preview { width: calc(100% - 48px); } }
  @media (max-width: 600px) { .preview { padding-block: 28px 48px; } .signature { align-self: flex-start; } .intro-author { font-size: 17px; } .intro-resume { padding: 9px 14px; gap: 10px; } }
  @media (max-width: 480px) { .preview { width: calc(100% - 40px); } h1 { font-size: clamp(30px, 8.6vw, 42px); } }
  @media (max-width: 600px) { .projects-plate { border-radius: 28px 28px 0 0; margin-top: -24px; padding-block: 56px 80px; } }

</style>







