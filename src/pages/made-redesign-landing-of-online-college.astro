---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import { withBase } from '../lib/paths';
import { collegeKonkurenti, collegeGalleryAl2 } from '../lib/college-images';
import '../styles/college-case.css';
const galleryItems = [1, 2, 3, 4] as const;
const captions = ['Первый экран Онлайн-колледжа', 'Возможности обучения', 'Направления обучения', 'Преподаватели Онлайн-колледжа'];
---
<BaseLayout title="Редизайн рекламного лендинга Онлайн-колледжа — Vanya Kolesnikov">
  <div class="college-header"><PortfolioHeader light /></div>
  <main class="college-story">
    <h1>Сделал редизайн рекламного лендинга Онлайн-колледжа</h1>
    <p>Проходил учебную практику от колледжа,<br class="desktop-break" /> работал в роли UX/UI дизайнера.</p>
    <section>
      <h2>Какая была проблема?</h2>
      <p>Сервис имел низкую конверсию и не выделялся на фоне конкурентов.</p>
    </section>
    <section>
      <h2>Что делал:</h2>
      <p>Перед началом работы изучил аналитику. Составил понимание о том, какие элементы влияют на пользовательский опыт, а какие не востребованы.</p>
      <figure class="college-competitors"><img src={collegeKonkurenti.desktop} alt="Анализ и сравнение лендингов конкурентов" loading="lazy" decoding="async" /></figure>
      <p>Онлайн-колледж должен выделяться на фоне конкурентов, вызывать доверие у новых клиентов и оставаться узнаваемым для тех, кто пришёл из Онлайн-школы. У меня была гипотеза: чтобы повысить конверсию, нужно сделать общение сайта с пользователем более структурированным и лёгким. От этого я поставил себе 3 задачи.</p>
      <ul class="college-tasks">
        <li>Сделать<br /> узнаваемым</li>
        <li>Провести клиента<br /> по сайту, отвечая на вопросы</li>
        <li>Разгрузить сайт</li>
      </ul>
    </section>
    <section>
      <h2>Сделал</h2>
      <p>Упростил восприятие информации и выстроил путь, по которому пользователь знакомится с ней постепенно. Сделал визуал современнее.</p>
      <div class="college-results">
        {galleryItems.map((i) => {
          const img = collegeGalleryAl2(i);
          return <picture><source media="(max-width: 440px)" srcset={img.mobile} /><img src={img.desktop} alt={captions[i - 1]} loading="lazy" decoding="async" /></picture>;
        })}
      </div>
      <p>Изменил вёрстку контента, объединил со стилем основного сайта с учётом аудитории.</p>
    </section>
    <section class="college-metrics">
      <h2>Мини-метрики</h2>
      <p>Провёл 5 презентаций проекта. Собрал более 60 макетов. Собрал положительные фидбеки от команды. Поработал в классной команде.</p>
    </section>
    <section class="college-comparison" aria-label="Сравнение лендинга до и после редизайна">
      <div class="comparison-controls" role="group" aria-label="Версия лендинга">
        <button type="button" data-version="0" aria-pressed="true">До</button>
        <button type="button" data-version="1" aria-pressed="false">После</button>
        <span>Листайте вбок для сравнения</span>
      </div>
      <div class="comparison-track" tabindex="0" aria-label="До и после. Используйте стрелки влево и вправо или свайп.">
        <figure aria-label="До редизайна"><img src={withBase('/made-redesign-landing-online-college/comparison-before.webp')} alt="Полная страница Онлайн-колледжа до редизайна" width="2000" height="11297" loading="lazy" decoding="async" /></figure>
        <figure aria-label="После редизайна"><img src={withBase('/made-redesign-landing-online-college/comparison-after.webp')} alt="Полная страница Онлайн-колледжа после редизайна" width="2000" height="11297" loading="lazy" decoding="async" /></figure>
      </div>
    </section>
    <a class="college-back" href={withBase('/')}>← Все проекты</a>
  </main>
</BaseLayout>
<script>
  const track = document.querySelector<HTMLElement>('.comparison-track');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-version]');
  if (track) {
    const select = (index: number) => track.scrollTo({ left: index * track.clientWidth, behavior: 'instant' });
    buttons.forEach(button => button.addEventListener('click', () => select(Number(button.dataset.version))));
    track.addEventListener('scroll', () => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
    }, { passive: true });
    track.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        select(event.key === 'ArrowLeft' ? 0 : 1);
      }
    });
  }
</script>
